@page "/solve"

@using BridgeGameCalculator.Client.Models
@using BridgeGameCalculator.Shared.Json
@using BridgeGameCalculator.Shared.Dtos
@using BridgeGameCalculator.Shared.Parsing
@using BridgeGameCalculator.Shared.Validation
@inject SessionState SessionState
@inject HttpClient Http
@inject NavigationManager Navigation


<h1>Solve Board</h1>

<div class="form-grid">
    <div class="form-row">
        <label>Dealer</label>
        <select @onchange="e => _model.Dealer = Enum.Parse<Seat>(e.Value!.ToString()!)">
            @foreach (Seat s in Enum.GetValues<Seat>())
            {
                <option value="@s" selected="@(_model.Dealer == s)">@s</option>
            }
        </select>
    </div>
    <div class="form-row">
        <label>Cards</label>
        <input class="hand-text-input"
               type="text"
               size="80"
               maxlength="80"
               @onchange="e => _model.Cards = e.Value!.ToString()!"
        </input>
    </div>
    <div class="form-row">
        <label>Strain</label>
        <select @onchange="e => { _model.ContractStrain = ParseNullableStrain(e.Value?.ToString()); }">
            <option value="">—</option>
            @foreach (Strain s in Enum.GetValues<Strain>())
            {
                <option value="@s" selected="@(_model.ContractStrain == s)">@s</option>
            }
        </select>
    </div>

</div>

<div class="submit-row">
    <button @onclick="HandleSolve" disabled="@_isSolving" class="analyze-button">
        @(_isSolving ? "Solving…" : "Solve")
    </button>
</div>

@if (_generalError is not null)
{
    <p class="error-message" role="alert">@_generalError</p>
}


@code {

    private readonly SolveBoardModel _model = new();
    private string? _generalError;
    private readonly Dictionary<string, string> _errors = new();
    private readonly Dictionary<string, HandParseResult> _parsed = new();
    private bool _isSolving;

    // -------------------------------------------------------------------------
    // Solve
    // -------------------------------------------------------------------------

    private async Task HandleSolve()
    {
        _generalError = null;
        _errors.Clear();
        _parsed.Clear();

        _isSolving = true;

        try
        {

            SingleHandSolveRequest request = new SingleHandSolveRequest();
            request.first = (((int?)_model.Declarer) ?? 0 + 1) % 4;

            request.trump = (((int?)_model.ContractStrain) ?? 0 + 1) % 5;

            request.remainingCards = _model.Cards;

            var response = await Http.PostAsJsonAsync("/api/solveboard", request, JsonDefaults.Options);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BoardSolveResult>(JsonDefaults.Options);
                if (result?.IsSuccess ?? false)
                {
                    SessionState.SolvedBoardsResult = result?.solvedBoards;
                    Navigation.NavigateTo("/solved");
                }
                else
                {
                    _generalError = result?.ErrorMessage;
                }

            }
            else
            {
                _generalError = "Solve Board failed";
            }
        }
        finally
        {
            _isSolving = false;
        }

    }
    private static Strain? ParseNullableStrain(string? value) =>
    Enum.TryParse<Strain>(value, out var s) ? s : null;

}
